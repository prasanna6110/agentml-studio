# ── AgentML Studio configuration ───────────────────────────────────────────
# Copy this file to `.env` and fill in ONE key. `.env` is git-ignored — never commit it.

# auto = first provider with a key (openai → gemini), else offline mock mode
AGENTML_PROVIDER=auto
# AGENTML_MODEL=gpt-4o-mini

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # or Groq / Together / any OpenAI-compatible API
GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434      # for local Llama / Qwen / Mistral via Ollama

AGENTML_TEMPERATURE=0.2
AGENTML_WORKSPACE=workspace
AGENTML_SEED=42
